import os
import env
import str
import sync
import gui.ui
import os.lockfile
import os.secret

include "@/core/checks.salam"
include "@/core/profile.salam"
include "@/system/appdirs.salam"
include "@/tunnel/state.salam"
include "@/tunnel/engine.salam"
include "@/tunnel/askpass.salam"
include "@/helper/helper.salam"
include "@/view/amounts.salam"
include "@/view/labels.salam"

const WIDTH := 360.0
const HEIGHT := 496.0

mut server := ""
mut port := "22"
mut user := ""
mut password := ""
mut remember := false
mut udp := false
mut can_remember := true
mut view := state.Snapshot {}

func refresh_view():
    view = state.Current()
end

func is_live(phase: int): bool:
    ret phase == state.UP or phase == state.RECONNECTING
end

func toggle():
    s := state.Current()
    if s.phase == state.CLOSING:
        ret
    end
    if s.phase != state.IDLE:
        state.RequestStop()
        ret
    end
    pr := profile.Profile {
        host = server.Trim(),
        port = port.Trim(),
        user = user.Trim(),
        password = str.Clone(password),
        remember = remember,
        udp = udp
    }
    problem := profile.Problem(pr)
    if problem.Len() > 0:
        state.Publish(state.Snapshot { message = problem, broken = s.broken })
        ret
    end
    profile.Save(pr)
    engine.Start(pr)
end

func repair():
    if state.Current().phase == state.IDLE:
        engine.StartRepair()
    end
end

page:
    title = "Salam Tunnel"
    background = "light dark(#f4f5f7, #0e1014)"
    color = "light dark(#101828, #f2f4f7)"
    box:
        padding = 16
        gap = 12
        StatusCard:
            title = labels.Title(view.phase)
            hint = labels.Hint(view.phase, view.message)
            busy = view.phase != state.IDLE
            up = view.phase == state.UP
        end
        Card:
            if is_live(view.phase):
                SessionPanel:
                    address = view.exit_ip.Len() > 0 ? view.exit_ip : "checking"
                    dns = labels.Dns(view)
                    sent = amounts.Bytes(view.up)
                    received = amounts.Bytes(view.down)
                    uptime = amounts.Elapsed(view.since)
                    connections = str.FromInt(view.active)
                end
            else:
                ConnectForm:
                    server = server
                    port = port
                    user = user
                    password = password
                    remember = remember
                    udp = udp
                    can_remember = can_remember
                    server_changed = (v: str): server = v end
                    port_changed = (v: str): port = v end
                    user_changed = (v: str): user = v end
                    password_changed = (v: str): password = v end
                    remember_toggled = (): remember = not remember end
                    udp_toggled = (): udp = not udp end
                end
            end
        end
        ActionButton:
            label = labels.Action(view.phase)
            stopping = view.phase != state.IDLE
            pressed = toggle
        end
        if view.broken:
            RepairButton:
                pressed = repair
            end
        end
        Footnote:
            label = labels.Footer(view, udp)
        end
    end
end

func close_app(): bool:
    if state.Current().phase != state.IDLE:
        state.RequestStop()
        deadline := sync.NowMs() + (10000 as i64)
        until sync.NowMs() < deadline and state.Current().phase != state.IDLE:
            sync.SleepMs(100)
        end
    end
    ret true
end

func load_saved():
    saved := profile.Load()
    server = saved.host
    port = saved.port
    user = saved.user
    password = saved.password
    remember = saved.remember
    udp = saved.udp
    can_remember = secret.Available()
end

func run_window(): int:
    lock := lockfile.Acquire(appdirs.LockFile())
    if not lock.acquired:
        println "Salam Tunnel is already open."
        ret 1
    end
    engine.StopOrphans()
    load_saved()
    state.Publish(state.Snapshot { broken = engine.NeedsRepair() })
    refresh_view()
    ui.SetAfterUpdate(
        ():
        refresh_view()
        ret true
        end
    )
    ui.OnCloseRequest((): ret close_app() end)
    window := ui.Options { width = WIDTH, height = HEIGHT, title = "Salam Tunnel" }
    ui.RunPageWith(
        (): ret ui.NoPatches() end, (b: ui.Builder): __salam_page(b) end, window
    )
    mut held := lock
    lockfile.Release(held)
    ret 0
end

func dispatch(): int:
    if env.Get("SALAM_TUNNEL_ASKPASS") == "1":
        ret askpass.Answer()
    end
    args := os.Args()
    if args.Len() == 9 and args.Get(1) == "--helper":
        ret helper.Run(
            args.Get(2),
            checks.PortNumber(args.Get(3)),
            args.Get(4),
            args.Get(5),
            args.Get(6),
            args.Get(7) == "1",
            args.Get(8)
        )
    end
    if args.Len() == 2 and args.Get(1) == "--repair":
        ret helper.Repair()
    end
    ret run_window()
end

func main:
    code := dispatch()
    ret code
end
