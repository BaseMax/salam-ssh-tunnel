package openssh

import os
import os.shell

pub func Path(): str:
    if SALAM_OS_WINDOWS:
        newer := os.Env("ProgramFiles") + "/OpenSSH/ssh.exe"
        if os.Exists(newer):
            ret newer
        end
        ret os.Env("SystemRoot") + "/System32/OpenSSH/ssh.exe"
    else:
        ret "/usr/bin/ssh"
    end
end

pub func NullFile(): str:
    if SALAM_OS_WINDOWS:
        ret "NUL"
    else:
        ret "/dev/null"
    end
end

pub func Version(banner: str): int:
    at := banner.Find("OpenSSH_")
    if at < 0:
        ret 0
    end
    mut parts := 0
    mut major := 0
    mut minor := 0
    mut inside := false
    p := banner as u8*
    repeat banner.Len() - at - 8 in k:
        c := p[at + 8 + k] as int
        digit := c - ('0' as int)
        if digit >= 0 and digit <= 9:
            inside = true
            if parts == 0:
                major = major * 10 + digit
            else:
                minor = minor * 10 + digit
            end
        else inside:
            inside = false
            parts++
            if parts == 2 or c != ('.' as int):
                break
            end
        end
    end
    ret major * 100 + minor
end

pub func TooOldForPasswords(): bool:
    if SALAM_OS_WINDOWS:
        mut args := Vector {} as Vector<str>
        args.Push("-V")
        r := shell.Run(Path(), args)
        found := Version(r.err + r.out)
        ret found > 0 and found < 804
    else:
        ret false
    end
end
