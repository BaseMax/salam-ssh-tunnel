package askpass

import os
import env

pub func Answer(): int:
    args := os.Args()
    prompt := args.Len() > 1 ? args.Get(1) : ""
    if not prompt.Includes("assword"):
        ret 1
    end
    println env.Get("SALAM_TUNNEL_PASSWORD")
    ret 0
end
