pub component RepairButton(pressed: func ()):
    button:
        id = "repair"
        padding = 9
        radius = 10
        font size = 13
        color = "light dark(#101828, #f2f4f7)"
        background = "light dark(#ffffff, #181b21)"
        border = 1, "solid", "light dark(#d0d5dd, #333a45)"
        click = (): pressed() end
        content = "Restore network settings"
    end
end
