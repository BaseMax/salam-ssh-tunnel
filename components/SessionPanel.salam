pub component SessionPanel(
    address: str, dns: str, sent: str, received: str, uptime: str, connections: str
):
    ExitAddress:
        address = address
        dns = dns
    end
    box:
        layout = "row"
        gap = 8
        StatTile:
            label = "Sent"
            amount = sent
        end
        StatTile:
            label = "Received"
            amount = received
        end
    end
    box:
        layout = "row"
        gap = 8
        StatTile:
            label = "Connected for"
            amount = uptime
        end
        StatTile:
            label = "Open connections"
            amount = connections
        end
    end
end
