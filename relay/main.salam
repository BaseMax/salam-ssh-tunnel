import io
import net.udprelay

func number(text: str): int:
    p := text as u8*
    mut n := 0
    repeat text.Len() in i:
        c := p[i] as int
        if c < ('0' as int) or c > ('9' as int) or n > 65535:
            ret 0
        end
        n = n * 10 + (c - ('0' as int))
    end
    ret n
end

func serve(): bool:
    given := args()
    if given.Len() == 3 and given[1] == "--listen":
        token := io.Input().Trim()
        ret udprelay.Listen(
            number(given[2]), token, 0 as i64, udprelay.ServerOptions { announce_fd = 1 as i64 }
        )
    end
    ret udprelay.Serve(0 as i64, 1 as i64, udprelay.ServerOptions {})
end

func main:
    ok := serve()
    ret ok ? 0 : 1
end
