package sshcmd

import str
import os.process
import os.desktop

include "@/core/profile.salam"
include "@/system/appdirs.salam"
include "@/system/openssh.salam"

pub func Base(pr: profile.Profile): process.Command:
    mut cmd := process.NewCommand(openssh.Path())
    cmd.Arg("-F")
    cmd.Arg(openssh.NullFile())
    cmd.Arg("-T")
    cmd.Arg("-p")
    cmd.Arg(pr.port)
    cmd.Arg("-l")
    cmd.Arg(pr.user)
    mut options := Vector {} as Vector<str>
    options.Push("HostKeyAlias=" + pr.host)
    options.Push(
        "UserKnownHostsFile=\"" + str.Replace(appdirs.KnownHostsFile(), "\\", "/") + "\""
    )
    options.Push("StrictHostKeyChecking=accept-new")
    options.Push("ConnectTimeout=20")
    options.Push("NumberOfPasswordPrompts=1")
    if pr.password.Len() > 0:
        options.Push("PreferredAuthentications=password,keyboard-interactive")
    end
    each o in options:
        cmd.Arg("-o")
        cmd.Arg(o)
    end
    if pr.password.Len() > 0:
        cmd.Env("SSH_ASKPASS", desktop.ExecutablePath())
        cmd.Env("SSH_ASKPASS_REQUIRE", "force")
        cmd.Env("SALAM_TUNNEL_ASKPASS", "1")
        cmd.Env("SALAM_TUNNEL_PASSWORD", pr.password)
    else:
        cmd.Env("SSH_ASKPASS_REQUIRE", "never")
    end
    ret cmd
end

pub func Target(cmd: process.Command, ip: str, remote: str): process.Command:
    mut out := cmd
    out.Arg("--")
    out.Arg(ip)
    if remote.Len() > 0:
        out.Arg(remote)
    end
    ret out
end
